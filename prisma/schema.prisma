generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEARNER
  SEO_MANAGER
  SOCIAL_MEDIA_MANAGER
  DEVELOPER
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
}

enum EnrollmentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String?
  role           Role      @default(LEARNER)
  image          String?
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  progress     Progress[]
  quizResults  QuizResult[]
  certificates Certificate[]
  notes        Note[]
  enrollments  Enrollment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Topic {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  icon        String   @default("Code2")
  color       String   @default("#22D3EE")
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Monetization
  isPaid       Boolean @default(false)
  priceInCents Int     @default(0)
  currency     String  @default("INR")

  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogImage         String?

  // AEO (Answer Engine Optimization)
  faqItems Json? // [{ question: string, answer: string }]

  chapters     Chapter[]
  quizzes      Quiz[]
  certificates Certificate[]
  enrollments  Enrollment[]
}

model Chapter {
  id      String @id @default(cuid())
  topicId String
  title   String
  order   Int    @default(0)

  topic   Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  quizzes Quiz[]

  @@index([topicId])
}

model Lesson {
  id              String  @id @default(cuid())
  chapterId       String
  title           String
  slug            String
  order           Int     @default(0)
  contentMarkdown String  @db.Text
  language        String  @default("html")
  starterCode     String  @db.Text
  runnable        Boolean @default(true)

  chapter  Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress Progress[]
  notes    Note[]

  @@unique([chapterId, slug])
}

model Quiz {
  id        String  @id @default(cuid())
  title     String
  topicId   String?
  chapterId String?

  topic     Topic?         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  chapter   Chapter?       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  results   QuizResult[]

  @@index([topicId])
  @@index([chapterId])
}

model QuizQuestion {
  id           String @id @default(cuid())
  quizId       String
  question     String
  options      Json
  correctIndex Int
  explanation  String
  order        Int    @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  savedCode String?  @db.Text
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model QuizResult {
  id      String   @id @default(cuid())
  userId  String
  quizId  String
  score   Int
  passed  Boolean
  takenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  topicId  String
  code     String   @unique
  issuedAt DateTime @default(now())
  pdfUrl   String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String   @db.Text
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Enrollment {
  id              String            @id @default(cuid())
  userId          String
  topicId         String
  gateway         PaymentGateway
  gatewayOrderId  String?
  gatewayPaymentId String?
  amountInCents   Int
  currency        String
  status          EnrollmentStatus  @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([gatewayOrderId])
}

model ContentBlock {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id          String   @id @default("singleton")
  heroBadge   String   @default("Classified curriculum · 47 case files")
  heroTitle   String   @default("Decode. Learn. Master.")
  heroSubtitle String  @default("Free tutorials, live code, and hands-on missions.")
  heroTagline String   @default("No sign-up needed, just start learning.")
  // Hero call-to-action buttons
  heroPrimaryCtaLabel   String @default("Request Clearance")
  heroPrimaryCtaHref    String @default("/signup")
  heroSecondaryCtaLabel String @default("Browse Case Files")
  heroSecondaryCtaHref  String @default("#case-files")
  // Hero feature bullets — one per line
  heroFeatures String @default("Clearance Level tracking\nLive code playground\nAgent Certification\nAI-powered hints")
  // "The Lab" preview card
  labCardLabel       String @default("The Lab")
  labCardTitle       String @default("Run real code, right in the browser.")
  labCardCode        String @default("function demo() {\n  console.log(\"Welcome, Agent.\");\n}\n\ndemo();")
  labCardDescription String @default("Every case file ships with a live Monaco editor, sandboxed preview, real terminal, and an AI hint on request.")
  // "More Case Files" grid heading
  moreCaseFilesTitle String @default("More Case Files")
  // Call-to-action banner
  ctaTitle    String   @default("Ready to earn your Agent Certification?")
  ctaSubtitle String   @default("Finish a case file, pass the quiz at 70% or higher, and download your certificate.")
  ctaButtonLabel String @default("Start Your First Mission")
  updatedAt   DateTime @updatedAt
}

model HomepageSection {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?  @db.Text
  imageUrl   String?
  buttonText String?
  buttonLink String?
  order      Int      @default(0)
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Prompt {
  id          String   @id @default(cuid())
  category    String
  title       String
  promptText  String   @db.Text
  previewHtml String?  @db.Text
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}
