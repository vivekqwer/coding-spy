# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/coding_spy?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — omit to disable the "Continue with Google" button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Code Hints ("Request Intel") — omit to fall back to canned hints
ANTHROPIC_API_KEY=""

# Razorpay (paid case files) — omit to disable the Razorpay checkout option
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe (paid case files) — omit to disable the Stripe checkout option
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
